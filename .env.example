# ── AI brain (Claude) ─────────────────────────────────────────────
# Get a key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low            # low | medium | high — low keeps voice replies snappy

# ── Your cloned voice (ElevenLabs) ────────────────────────────────
# 1. elevenlabs.io → Voices → Add a new voice → Instant Voice Clone
# 2. Upload 1–3 minutes of clean recordings of yourself
# 3. Copy the Voice ID from the voice's settings
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: eleven_flash_v2_5 (fastest) | eleven_multilingual_v2 (richest)
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
